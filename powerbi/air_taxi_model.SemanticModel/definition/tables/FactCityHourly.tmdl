table FactCityHourly
	lineageTag: c1a420a7-7724-4bfc-9cf3-7860731f5add
	sourceLineageTag: [dbo].[FactCityHourly]

	measure 'Corr Hour PM25' =
			VAR t = FILTER(FactCityHourly, NOT ISBLANK(FactCityHourly[pm25_avg]))
			VAR n = COUNTROWS(t)
			VAR sx = SUMX(t, FactCityHourly[pm25_avg])
			VAR sy = SUMX(t, FactCityHourly[trips])
			VAR sxy = SUMX(t, FactCityHourly[pm25_avg] * FactCityHourly[trips])
			VAR sx2 = SUMX(t, FactCityHourly[pm25_avg] * FactCityHourly[pm25_avg])
			VAR sy2 = SUMX(t, FactCityHourly[trips] * FactCityHourly[trips])
			RETURN
			    DIVIDE(n * sxy - sx * sy, SQRT((n * sx2 - sx * sx) * (n * sy2 - sy * sy)))
		formatString: 0.00
		lineageTag: b6e362e2-0ae8-4424-ad3d-4f896b8541b5

	measure 'Corr Hour NO2' =
			VAR t = FILTER(FactCityHourly, NOT ISBLANK(FactCityHourly[no2_avg]))
			VAR n = COUNTROWS(t)
			VAR sx = SUMX(t, FactCityHourly[no2_avg])
			VAR sy = SUMX(t, FactCityHourly[trips])
			VAR sxy = SUMX(t, FactCityHourly[no2_avg] * FactCityHourly[trips])
			VAR sx2 = SUMX(t, FactCityHourly[no2_avg] * FactCityHourly[no2_avg])
			VAR sy2 = SUMX(t, FactCityHourly[trips] * FactCityHourly[trips])
			RETURN
			    DIVIDE(n * sxy - sx * sy, SQRT((n * sx2 - sx * sx) * (n * sy2 - sy * sy)))
		formatString: 0.00
		lineageTag: 192fea6f-77b3-456e-b6ea-0c8b55dbd3f4

