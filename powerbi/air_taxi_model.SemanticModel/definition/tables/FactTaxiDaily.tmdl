table FactTaxiDaily
	lineageTag: f7d983c2-5808-4285-acee-e50f98d1d61a
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure Trips = SUM(FactTaxiDaily[trip_count])
		formatString: #,0
		lineageTag: 67d26b15-9289-4283-832b-ef66516d4854

		changedProperty = Name

	measure 'Trips per Day' = DIVIDE([Trips], DISTINCTCOUNT(FactTaxiDaily[date_key]))
		formatString: #,0
		lineageTag: a7110ebe-e2c5-4be4-8a5e-79adb5c821cd

	measure 'Avg Fare USD' = DIVIDE(SUM(FactTaxiDaily[total_fare_usd]), [Trips])
		formatString: 0.00
		lineageTag: 7a79fc66-4c2a-4e15-9116-6b94d85046c7

		changedProperty = Name

	measure 'Revenue USD' = SUM(FactTaxiDaily[total_amount_usd])
		formatString: #,0
		lineageTag: 04d375da-774e-415f-a1cf-5efa7599d478

		changedProperty = Name

	measure 'Revenue EUR' =
			SUMX(
			    VALUES(DimDate[date_key]),
			    DIVIDE(
			        CALCULATE(SUM(FactTaxiDaily[total_amount_usd])),
			        CALCULATE(MAX(DimFX[usd_per_eur]))
			    )
			)
		formatString: #,0
		lineageTag: bd4d7238-7dab-440b-933b-396e1de75349

		changedProperty = Name

	measure 'Avg Revenue USD' = DIVIDE([Revenue USD], [Trips])
		formatString: 0.00
		lineageTag: 66517530-3970-4aaf-846d-0c2c2c9eda5a

		changedProperty = Name

	measure 'Avg Revenue EUR' = DIVIDE([Revenue EUR], [Trips])
		formatString: 0.00
		lineageTag: 1e3efeb5-77ed-4e8f-9534-117d9725b7bc

		changedProperty = Name

	measure 'USD per EUR' = AVERAGE(DimFX[usd_per_eur])
		formatString: 0.0000
		lineageTag: 2808dea7-9fc6-409e-af7a-79ff11ad9d05

		changedProperty = Name

	measure 'GDP USD' =
			CALCULATE(
			    MAX(DimGDP[gdp_usd]),
			    TREATAS(VALUES(DimDate[year]), DimGDP[year])
			)
		formatString: #,0
		lineageTag: 15c7da2d-d947-439e-9721-49478adc1039

		changedProperty = Name

	measure 'Avg Distance Miles' = DIVIDE(SUM(FactTaxiDaily[total_distance_miles]), [Trips])
		formatString: 0.00
		lineageTag: 8e5f3dbf-d098-473a-8f68-1042bacec4a3

		changedProperty = Name

	measure 'Corr Trips PM25' =
			VAR t =
			    FILTER(
			        ADDCOLUMNS(VALUES(DimDate[date_key]), "x", [PM25], "y", [Trips]),
			        NOT ISBLANK([x]) && NOT ISBLANK([y])
			    )
			VAR n = COUNTROWS(t)
			VAR sx = SUMX(t, [x])
			VAR sy = SUMX(t, [y])
			VAR sxy = SUMX(t, [x] * [y])
			VAR sx2 = SUMX(t, [x] * [x])
			VAR sy2 = SUMX(t, [y] * [y])
			RETURN
			    DIVIDE(n * sxy - sx * sy, SQRT((n * sx2 - sx * sx) * (n * sy2 - sy * sy)))
		formatString: 0.00
		lineageTag: 45b2258e-35d1-4953-a492-63c2a6e0bcdf

	measure 'Corr Trips NO2' =
			VAR t =
			    FILTER(
			        ADDCOLUMNS(VALUES(DimDate[date_key]), "x", [NO2], "y", [Trips]),
			        NOT ISBLANK([x]) && NOT ISBLANK([y])
			    )
			VAR n = COUNTROWS(t)
			VAR sx = SUMX(t, [x])
			VAR sy = SUMX(t, [y])
			VAR sxy = SUMX(t, [x] * [y])
			VAR sx2 = SUMX(t, [x] * [x])
			VAR sy2 = SUMX(t, [y] * [y])
			RETURN
			    DIVIDE(n * sxy - sx * sy, SQRT((n * sx2 - sx * sx) * (n * sy2 - sy * sy)))
		formatString: 0.00
		lineageTag: b1430939-c08d-4b38-a5c7-8d6b4b87cfa6

