table FactAirQualityDaily
	lineageTag: d23507c8-1863-4245-aa0d-54955d413387
	sourceLineageTag: [dbo].[FactAirQualityDaily]

	measure PM25 =
			CALCULATE(
			    DIVIDE(
			        SUMX(FactAirQualityDaily, FactAirQualityDaily[avg_value] * FactAirQualityDaily[measurement_count]),
			        SUM(FactAirQualityDaily[measurement_count])
			    ),
			    FactAirQualityDaily[parameter] = "pm25"
			)
		formatString: 0.00
		lineageTag: 7234f39c-b8e1-4503-80dd-7448f1cfbab7

	measure NO2 =
			CALCULATE(
			    DIVIDE(
			        SUMX(FactAirQualityDaily, FactAirQualityDaily[avg_value] * FactAirQualityDaily[measurement_count]),
			        SUM(FactAirQualityDaily[measurement_count])
			    ),
			    FactAirQualityDaily[parameter] = "no2"
			)
		formatString: 0.0000
		lineageTag: e230fecd-94a7-420a-a216-a07962f33b2f

